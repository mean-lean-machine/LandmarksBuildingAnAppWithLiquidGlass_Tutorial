require "base64"
require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Build and upload a QA build to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]

    key_filepath = File.join(Dir.mktmpdir, "AuthKey_#{key_id}.p8")
    File.write(key_filepath, Base64.decode64(ENV["App_Store_Connect"]))

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath
    )

    increment_build_number(
      xcodeproj: "Landmarks.xcodeproj",
      build_number: ENV["CIRCLE_BUILD_NUM"]
    )

    build_app(
      project: "Landmarks.xcodeproj",
      scheme: "Landmarks",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath \"#{key_filepath}\" " \
              "-authenticationKeyID \"#{key_id}\" " \
              "-authenticationKeyIssuerID \"#{issuer_id}\""
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
