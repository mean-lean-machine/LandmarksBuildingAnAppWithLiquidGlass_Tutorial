require "base64"
require "shellwords"
require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Build and upload a QA build to TestFlight"
  lane :beta do
    setup_ci

    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]

    key_filepath = File.join(Dir.mktmpdir, "AuthKey_#{key_id}.p8")
    File.write(key_filepath, Base64.decode64(ENV["App_Store_Connect"]))

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath
    )

    cert_filepath = File.join(Dir.mktmpdir, "distribution.p12")
    File.write(cert_filepath, Base64.decode64(ENV["DISTRIBUTION_CERTIFICATE_P12"]))

    UI.message("Contents of the .p12 (metadata only, no key material):")
    sh("openssl pkcs12 -in #{cert_filepath.shellescape} " \
       "-passin pass:#{ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"].shellescape} " \
       "-info -noout 2>&1 || true")

    import_certificate(
      certificate_path: cert_filepath,
      certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
      log_output: true
    )

    profile_filepath = File.join(Dir.mktmpdir, "profile.mobileprovision")
    File.write(profile_filepath, Base64.decode64(ENV["PROVISIONING_PROFILE"]))
    install_provisioning_profile(path: profile_filepath)

    UI.message("Signing identities visible on the default keychain search list:")
    sh("security find-identity -v -p codesigning")

    profile_plist_path = "#{profile_filepath}.plist"
    sh("security cms -D -i #{profile_filepath.shellescape} > #{profile_plist_path.shellescape}")
    profile_uuid = sh("/usr/libexec/PlistBuddy -c 'Print :UUID' #{profile_plist_path.shellescape}").strip

    increment_build_number(
      xcodeproj: "Landmarks.xcodeproj",
      build_number: ENV["CIRCLE_BUILD_NUM"]
    )

    build_app(
      project: "Landmarks.xcodeproj",
      scheme: "Landmarks",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY=\"Apple Distribution\" " \
              "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_uuid}\" " \
              "DEVELOPMENT_TEAM=QYDW2XADD8",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.example.apple-samplecode.LandmarksQYDW2XADD8" => profile_uuid
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
